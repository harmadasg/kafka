{
  "apiKey": 31,
  "type": "metadata",
  "name": "VirtualClusterChangeRecord",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "fields": [
    { "name": "Name", "type": "string", "versions": "0+",
      "about": "The name of the virtual cluster being changed." },
    { "name": "AddedTopics", "type": "[]VirtualClusterTopicLink", "versions": "0+",
      "about": "Topic links added to this virtual cluster.",
      "fields": [
        { "name": "TopicName", "type": "string", "versions": "0+",
          "about": "The physical topic name." },
        { "name": "LinkName", "type": "string", "versions": "0+",
          "about": "The link name within the virtual cluster." }
      ]
    },
    { "name": "RemovedTopics", "type": "[]string", "versions": "0+",
      "about": "Physical topic names of topic links removed from this virtual cluster." },
    { "name": "AddedUsers", "type": "[]string", "versions": "0+",
      "about": "Users added to this virtual cluster." },
    { "name": "RemovedUsers", "type": "[]string", "versions": "0+",
      "about": "Users removed from this virtual cluster." },
    { "name": "AddedClients", "type": "[]string", "versions": "0+",
      "about": "Clients added to this virtual cluster." },
    { "name": "RemovedClients", "type": "[]string", "versions": "0+",
      "about": "Clients removed from this virtual cluster." },
    { "name": "AddedGroups", "type": "[]string", "versions": "0+",
      "about": "Consumer groups added to this virtual cluster." },
    { "name": "RemovedGroups", "type": "[]string", "versions": "0+",
      "about": "Consumer groups removed from this virtual cluster." },
    { "name": "AddedTransactionalIds", "type": "[]string", "versions": "0+",
      "about": "Transactional IDs added to this virtual cluster." },
    { "name": "RemovedTransactionalIds", "type": "[]string", "versions": "0+",
      "about": "Transactional IDs removed from this virtual cluster." }
  ]
}
